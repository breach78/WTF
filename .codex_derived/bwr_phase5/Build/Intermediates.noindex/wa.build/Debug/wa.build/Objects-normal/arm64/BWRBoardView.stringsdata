      },
      {
        "comment": "",
        "key": "Single click selects a card or slot.",
        "location": {
          "startingColumn": 18,
          "startingLine": 710
        }
      },
      {
        "comment": "",
        "key": "The dark slot is the keyboard cursor anchor.",
        "location": {
          "startingColumn": 18,
          "startingLine": 712
        }
      },
      {
        "comment": "",
        "key": "The dotted slot follows hover and stays separate from selection.",
        "location": {
          "startingColumn": 18,
          "startingLine": 714
        }
      },
      {
        "comment": "",
        "key": "Command-click adds or removes cards from the current selection.",
        "location": {
          "startingColumn": 18,
          "startingLine": 716
        }
      },
      {
        "comment": "",
        "key": "Shift-click grows a sequence selection from the anchored card.",
        "location": {
          "startingColumn": 18,
          "startingLine": 718
        }
      },
      {
        "comment": "",
        "key": "Drag on empty space to marquee-select cards or slots.",
        "location": {
          "startingColumn": 18,
          "startingLine": 720
        }
      },
      {
        "comment": "",
        "key": "Press Return on the cursor slot to edit a card or create one.",
        "location": {
          "startingColumn": 18,
          "startingLine": 722
        }
      },
      {
        "comment": "",
        "key": "Press Tab or Shift-Tab to save and continue editing next or previous slots.",
        "location": {
          "startingColumn": 18,
          "startingLine": 724
        }
      },
      {
        "comment": "",
        "key": "Use Arrow keys to move the cursor, and Option-Arrow to move the selected card.",
        "location": {
          "startingColumn": 18,
          "startingLine": 726
        }
      },
      {
        "comment": "",
        "key": "Double-click a card to edit markdown inline.",
        "location": {
          "startingColumn": 18,
          "startingLine": 728
        }
      },
      {
        "comment": "",
        "key": "Double-click an empty slot to create a new card there.",
        "location": {
          "startingColumn": 18,
          "startingLine": 730
        }
      },
      {
        "comment": "",
        "key": "Single-card drags swap, sequence drags insert, and cluster drags stay rigid.",
        "location": {
          "startingColumn": 18,
          "startingLine": 732
        }
      },
      {
        "comment": "",
        "key": "Long-press a card to cycle its paper color.",
